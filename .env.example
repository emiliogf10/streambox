# ===================================================================
# Variables de StreamBox para Docker Compose (docker-compose.yml)
#
# 1. Copia este archivo como ".env" en esta misma carpeta (la raíz del
#    repositorio):   cp .env.example .env
# 2. Rellena los valores. ".env" está en .gitignore: tus secretos nunca se
#    suben al repositorio. ESTE archivo (.env.example) sí se sube, así que
#    NUNCA escribas aquí valores reales.
# 3. docker compose up -d --build
#
# Las obligatorias se dejan VACÍAS a propósito: si se te olvida rellenarlas,
# docker compose se niega a arrancar y te dice cuál falta. Con un valor de
# ejemplo arrancaría igual, pero con un secreto que conoce cualquiera que
# lea este archivo.
#
# Ojo: si una variable también existe en tu terminal (p. ej. JWT_SECRET en
# las variables de Windows), la de la terminal gana a la de este archivo.
#
# Formato: VARIABLE=valor, sin espacios alrededor del "=" y sin comillas.
# ===================================================================


# ---------- Base de datos (PostgreSQL del contenedor "db") ----------

# OBLIGATORIA. Contraseña del usuario de PostgreSQL. La usan la base (al
# crearse) y el backend (para conectarse). Genera una con:
#   openssl rand -base64 32
# En Windows, openssl viene con Git Bash. Desde PowerShell 7:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# (no uses Get-Random: no es un generador criptográficamente seguro).
POSTGRES_PASSWORD=

# Opcionales: nombre de la base y del usuario (por defecto "streambox").
# Solo se aplican la PRIMERA vez que se crea el volumen de datos; para
# cambiarlos después hay que borrarlo (docker compose down -v ⚠ borra datos).
POSTGRES_DB=streambox
POSTGRES_USER=streambox


# ---------- JWT (firma de los tokens de sesión) ----------

# OBLIGATORIA. Secreto de al menos 32 caracteres (la aplicación no arranca
# con uno más corto). Quien lo conozca puede fabricar tokens válidos, así
# que debe ser aleatorio y no reutilizarse. Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=

# Opcional: horas de validez del token (por defecto 24).
JWT_EXPIRATION_HOURS=24


# ---------- Administrador inicial (opcional) ----------
# Si ADMIN_EMAIL y ADMIN_PASSWORD tienen valor, al arrancar se crea un
# usuario con rol ADMIN (solo si no existe ya). Si los dejas vacíos no se
# crea ninguno: el registro público solo crea usuarios normales.
#
# La contraseña debe cumplir la política de contraseñas; si no, el backend
# NO ARRANCA al intentar crear el administrador (mira los logs con
# "docker compose logs backend"):
#   - entre 12 y 64 caracteres (máximo 72 bytes: cuidado con muchas tildes);
#   - no puede ser una contraseña común ni trivial ("password1234",
#     "aaaaaaaaaaaa"...);
#   - no puede contener el nombre de usuario ni la parte del email antes
#     de la "@" (si tienen 4 caracteres o más).
# Una frase de cuatro o cinco palabras al azar funciona bien.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=


# ---------- Acceso desde el navegador (nginx, servicio "frontend") ----------

# Opcional: puerto de tu máquina en el que se abre StreamBox
# (http://localhost:8088 por defecto). Es el ÚNICO puerto publicado: la web
# y la API (/api/...) van por él. No uses 8080 ni 5173, que son los del
# backend y el Vite de desarrollo; si el 8088 está ocupado, elige otro libre.
STREAMBOX_PORT=8088

# Opcional: desde dónde se acepta la conexión. 127.0.0.1 (por defecto) =
# solo desde este equipo. 0.0.0.0 = también desde otros dispositivos de tu
# red (p. ej. el móvil); hazlo solo en una red de confianza, porque va por
# HTTP sin cifrar (contraseñas y tokens incluidos).
STREAMBOX_BIND_ADDRESS=127.0.0.1
