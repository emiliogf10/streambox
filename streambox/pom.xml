<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion>
<parent>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-parent</artifactId>
<version>4.1.1</version>
<relativePath />
</parent>
<groupId>com.emilio</groupId>
<artifactId>streambox</artifactId>
<version>0.0.1-SNAPSHOT</version>
<name />
<description />
<url />
<licenses><license /></licenses>
<developers><developer /></developers>
<scm><connection /><developerConnection /><tag /><url /></scm>
<properties>
<java.version>21</java.version>
<!--
  PARCHES DE SEGURIDAD TEMPORALES (2026-10-15) sobre versiones que fija el
  padre. Spring Boot 4.1.1 (el ultimo publicado) gestiona Tomcat 11.0.24 y
  Jackson 2.21.5 / 3.1.5, que tienen 17 vulnerabilidades conocidas que llegan
  a produccion (las detecta OSV-Scanner en .github/workflows/seguridad.yml).
  Sobrescribir estas propiedades de spring-boot-dependencies cambia la
  version de TODOS los artefactos de cada grupo a la vez (sin mezclas).
  Solo subidas de parche, y la version mas reciente con al menos 7 dias
  publicada (el mismo criterio que el "cooldown" de Dependabot).

  QUITAR CADA PROPIEDAD al subir el padre a un Spring Boot que gestione esa
  version o una mayor (miralo en su spring-boot-dependencies-X.pom). Si se
  deja, ganaria a la del padre nuevo y podria dejarnos en una version MAS
  ANTIGUA: Dependabot sube el padre pero no toca estas propiedades.
-->
<!--
  Tomcat (servidor web embebido): 11.0.24 tiene 3 vulnerabilidades criticas
  (GHSA-9xv2-5v5q-p794, GHSA-gcx9-497g-6cp6, GHSA-h3x4-894j-xpx5), arregladas
  en 11.0.25. La propiedad cubre tomcat-embed-core, -el y -websocket.
-->
<tomcat.version>11.0.27</tomcat.version>
<!--
  Jackson 2 (com.fasterxml.jackson): lo usa jjwt-jackson para leer los JWT.
  2.21.5 tiene vulnerabilidades altas y medias en jackson-core y
  jackson-databind, arregladas en 2.21.7.
-->
<jackson-2-bom.version>2.21.7</jackson-2-bom.version>
<!--
  Jackson 3 (tools.jackson): el JSON de Spring MVC (peticiones y respuestas de
  toda la API). 3.1.5 tiene vulnerabilidades altas y medias en jackson-core y
  jackson-databind, arregladas en 3.1.7.
-->
<jackson-bom.version>3.1.7</jackson-bom.version>
</properties>
<dependencies>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-data-jpa</artifactId>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-validation</artifactId>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-webmvc</artifactId>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-security</artifactId>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-actuator</artifactId>
</dependency>
<!--
  Envio de correo (verificacion del email al registrarse, 2026-10-18). Es el
  starter oficial de Spring: trae Jakarta Mail (Angus Mail) y autoconfigura un
  JavaMailSender a partir de spring.mail.* solo si spring.mail.host esta
  definido. Escribir SMTP a mano seria reinventar un protocolo con TLS y
  autenticacion; una libreria de un proveedor (SendGrid, Resend...) ataria el
  proyecto a ese proveedor, mientras que SMTP vale para todos (y para Mailpit
  en docker compose). Version gestionada por el padre (sin sobrescrituras).
  Uso: email/SmtpEmailSender (ver email/EmailSenderConfig).
-->
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-mail</artifactId>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-devtools</artifactId>
<scope>runtime</scope>
<optional>true</optional>
</dependency>
<dependency>
<groupId>org.postgresql</groupId>
<artifactId>postgresql</artifactId>
<scope>runtime</scope>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-flyway</artifactId>
</dependency>
<dependency>
<groupId>org.flywaydb</groupId>
<artifactId>flyway-database-postgresql</artifactId>
</dependency>
<dependency>
<groupId>org.projectlombok</groupId>
<artifactId>lombok</artifactId>
<optional>true</optional>
</dependency>
<dependency>
<groupId>org.springdoc</groupId>
<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
<version>3.1.1</version>
</dependency>
<dependency>
<groupId>io.jsonwebtoken</groupId>
<artifactId>jjwt-api</artifactId>
<version>0.13.0</version>
</dependency>
<dependency>
<groupId>io.jsonwebtoken</groupId>
<artifactId>jjwt-impl</artifactId>
<version>0.13.0</version>
<scope>runtime</scope>
</dependency>
<dependency>
<groupId>io.jsonwebtoken</groupId>
<artifactId>jjwt-jackson</artifactId>
<version>0.13.0</version>
<scope>runtime</scope>
</dependency>
<!-- TEST -->
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-webmvc-test</artifactId>
<scope>test</scope>
</dependency>
<dependency>
<groupId>com.h2database</groupId>
<artifactId>h2</artifactId>
<scope>test</scope>
</dependency>
<!--
  Tests contra PostgreSQL real (tarea 22). Versiones gestionadas por el BOM de
  Spring Boot (Testcontainers 2.x). Solo scope test: no entran en el JAR final.
  La integracion con JUnit 5 (@Testcontainers, disabledWithoutDocker) y el
  modulo de PostgreSQL. El contenedor se conecta a la aplicacion con
  @DynamicPropertySource (ver PostgresIntegrationTestSupport), por lo que no
  hace falta spring-boot-testcontainers (@ServiceConnection).
-->
<dependency>
<groupId>org.testcontainers</groupId>
<artifactId>testcontainers-junit-jupiter</artifactId>
<scope>test</scope>
</dependency>
<dependency>
<groupId>org.testcontainers</groupId>
<artifactId>testcontainers-postgresql</artifactId>
<scope>test</scope>
</dependency>
</dependencies>
<build>
<plugins>
<plugin>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-maven-plugin</artifactId>
<configuration>
<excludes>
<exclude>
<groupId>org.projectlombok</groupId>
<artifactId>lombok</artifactId>
</exclude>
</excludes>
</configuration>
</plugin>
<!--
  Archivos que NUNCA deben entrar en el JAR (target/*.jar).
  application-local.properties contiene las credenciales de la base de datos
  de desarrollo (Supabase) y vive en src/main/resources, asi que por defecto
  Maven lo copiaria a target/classes y de ahi al JAR: cualquiera que recibiera
  un JAR construido en local con "mvnw package" tendria la contrasena, y al
  ejecutarlo se conectaria a esa base (application.properties lo importa
  siempre con spring.config.import=optional:...).
  Se excluye SOLO del empaquetado, no del proceso de recursos: sigue copiandose
  a target/classes, que es lo que usan spring-boot:run, el IDE y los tests, asi
  que el desarrollo local funciona igual. La imagen Docker ya lo dejaba fuera
  con streambox/.dockerignore; esto cubre el JAR local.
  La plantilla *.example no es secreta, pero no pinta nada en el JAR.
  El repackage de spring-boot-maven-plugin parte de este JAR, asi que la
  exclusion llega tambien al JAR ejecutable. Version gestionada por el parent.
-->
<plugin>
<groupId>org.apache.maven.plugins</groupId>
<artifactId>maven-jar-plugin</artifactId>
<configuration>
<excludes>
<exclude>**/application-local*.properties</exclude>
<exclude>**/*.example</exclude>
</excludes>
</configuration>
</plugin>
<plugin>
<groupId>org.apache.maven.plugins</groupId>
<artifactId>maven-compiler-plugin</artifactId>
<executions>
<execution>
<id>default-compile</id>
<phase>compile</phase>
<goals><goal>compile</goal></goals>
<configuration>
<annotationProcessorPaths>
<path>
<groupId>org.projectlombok</groupId>
<artifactId>lombok</artifactId>
</path>
</annotationProcessorPaths>
</configuration>
</execution>
<execution>
<id>default-testCompile</id>
<phase>test-compile</phase>
<goals><goal>testCompile</goal></goals>
<configuration>
<annotationProcessorPaths>
<path>
<groupId>org.projectlombok</groupId>
<artifactId>lombok</artifactId>
</path>
</annotationProcessorPaths>
</configuration>
</execution>
</executions>
</plugin>
<!--
  RECORDATORIO OBLIGATORIO de los parches de seguridad de <properties>
  (tomcat.version, jackson-2-bom.version, jackson-bom.version).
  Esas propiedades ganan a las del padre: si Dependabot sube Spring Boot y
  nadie las quita, podriamos quedarnos en una version MAS ANTIGUA que la que
  trae el padre nuevo, sin que nada avise. Esta regla hace que el build falle
  en cuanto cambia la version del padre, asi que el pull request de Dependabot
  se quedara en rojo en el CI hasta que alguien revise las propiedades: quitar
  las que el padre nuevo ya cubre y actualizar aqui la version esperada (o
  quitar la regla).
  Fase validate: falla al principio de cualquier comando de Maven (compile,
  test, package...), antes de compilar nada.
  SE QUITA JUNTO CON LA ULTIMA SOBRESCRITURA: sin parches no hay nada que
  recordar. Version del plugin gestionada por el parent.
-->
<plugin>
<groupId>org.apache.maven.plugins</groupId>
<artifactId>maven-enforcer-plugin</artifactId>
<executions>
<execution>
<id>revisar-parches-al-subir-spring-boot</id>
<phase>validate</phase>
<goals><goal>enforce</goal></goals>
<configuration>
<rules>
<requireProperty>
<property>project.parent.version</property>
<regex>4\.1\.1</regex>
<regexMessage>Has cambiado la version de Spring Boot (spring-boot-starter-parent). Revisa las propiedades tomcat.version, jackson-2-bom.version y jackson-bom.version de pom.xml: quita cada una si el padre nuevo ya trae esa version o una mayor (miralo en su spring-boot-dependencies-X.pom). Despues actualiza la version esperada en esta regla del maven-enforcer-plugin, o quita la regla si ya no queda ninguna sobrescritura.</regexMessage>
</requireProperty>
</rules>
</configuration>
</execution>
</executions>
</plugin>
</plugins>
</build>
</project>